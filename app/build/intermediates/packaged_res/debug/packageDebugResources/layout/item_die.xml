<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dieContainer"
    android:layout_width="60dp"
    android:layout_height="60dp"
    android:layout_margin="4dp"
    android:background="@drawable/die_background"
    android:padding="8dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:columnCount="3"
        android:rowCount="3">

        <View android:id="@+id/pip0" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="0" android:layout_column="0" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <View android:id="@+id/pip1" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="0" android:layout_column="2" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <View android:id="@+id/pip2" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="1" android:layout_column="0" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <View android:id="@+id/pip3" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="1" android:layout_column="1" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <View android:id="@+id/pip4" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="1" android:layout_column="2" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <View android:id="@+id/pip5" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="2" android:layout_column="0" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />
        <View android:id="@+id/pip6" android:layout_width="0dp" android:layout_height="0dp"
            android:layout_margin="2dp" android:background="@drawable/die_pip"
            android:layout_row="2" android:layout_column="2" android:layout_gravity="fill"
            android:layout_columnWeight="1" android:layout_rowWeight="1" />

    </GridLayout>

</FrameLayout>

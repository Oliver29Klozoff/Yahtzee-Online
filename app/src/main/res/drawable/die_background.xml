<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/die_held" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/brand_primary_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/die_normal" />
            <corners android:radius="8dp" />
            <stroke android:width="2dp" android:color="@color/brand_primary" />
        </shape>
    </item>
</selector>

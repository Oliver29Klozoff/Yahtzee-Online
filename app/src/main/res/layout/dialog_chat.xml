<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_title"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="10dp" />

    <!--
        The history takes all the space left over, so the composer stays reachable at the bottom
        whatever the message count or the system font size.
    -->
    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

    <TextView
        android:id="@+id/chatEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_empty"
        android:textSize="13sp"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        android:textColor="@color/text_muted"
        android:visibility="gone" />

    <!--
        What is being replied to, directly above the box it will be sent from, so the thing the
        message is answering is the last thing read before typing it.
    -->
    <LinearLayout
        android:id="@+id/chatReplyBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chatReplyLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/chatReplyCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/chat_reply_cancel"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <EditText
            android:id="@+id/chatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chat_hint"
            android:inputType="textShortMessage|textCapSentences|textAutoCorrect"
            android:imeOptions="actionSend"
            android:maxLines="3"
            android:textSize="15sp"
            android:autofillHints=""
            android:textColor="@color/text_dark"
            android:textColorHint="@color/text_muted" />

        <Button
            android:id="@+id/chatSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chat_send"
            android:tag="accentBg"
            android:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>

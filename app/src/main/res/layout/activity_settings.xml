<?xml version="1.0" encoding="utf-8"?><!--
    fillViewport keeps the weighted spacer working: on a tall screen the content is shorter
    than the viewport, so the spacer expands and pins the update controls to the bottom; once
    the settings outgrow the screen the spacer collapses and the page simply scrolls. Without
    the ScrollView everything past the fold was unreachable.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/settingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dice_color"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="14dp" />

    <com.yahtzee.online.dice3d.Dice3DView
        android:id="@+id/dicePreview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginBottom="16dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/diceColorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/custom_colour"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="18dp" />

    <SeekBar
        android:id="@+id/hueSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="359" />

    <SeekBar
        android:id="@+id/saturationSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <SeekBar
        android:id="@+id/brightnessSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pip_style"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/pipStyleButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="110dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_dice"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/saveDiceButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_dice" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/savedDiceRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <TextView
        android:id="@+id/savedDiceEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_saved_dice"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:paddingTop="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/table_colour"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/text_muted"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tableColorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/table_logo"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/tableLogoButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <Button
        android:id="@+id/chooseLogoButton"
        style="@style/Widget.AppCompat.Button.Borderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/table_logo_choose"
        android:textSize="13sp"
        android:textColor="@color/text_muted" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_accent"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/text_muted"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/accentColorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_recovery"
        android:textAllCaps="true"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="@color/text_muted"
        android:layout_marginTop="26dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profile_recovery_explainer"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/recoveryCodeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/scorecard_card_background"
        android:padding="14dp"
        android:gravity="center"
        android:textIsSelectable="true"
        android:fontFamily="monospace"
        android:textSize="14sp"
        android:letterSpacing="0.04"
        android:textColor="@color/text_dark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/copyRecoveryButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/copy_code"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary" />

        <Button
            android:id="@+id/restoreProfileButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/restore_profile"
            android:textSize="13sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/keep_screen_on"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/keepScreenOnButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/confirm_scoring"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/confirmScoringButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sound_effects"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/soundButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/haptics"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/hapticsButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/dice_motion"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/diceMotionButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bot_skill"
            android:textSize="15sp"
            android:textColor="@color/text_dark" />

        <Button
            android:id="@+id/botSkillButton"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="80dp" />

    </LinearLayout>

    <!-- Pushes the update controls and version down to the bottom of the screen. -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/row_border"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/checkForUpdatesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/check_for_updates" />

    <ProgressBar
        android:id="@+id/checkForUpdatesProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:textSize="14sp"
        android:textColor="@color/text_muted"
        android:layout_marginTop="16dp"
        android:paddingBottom="8dp" />

</LinearLayout>

</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="44sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_home_subtitle"
        android:textSize="17sp"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="40dp" />

    <!--
        Two buttons and nothing else. A remote has a direction pad and a select key, so the whole
        screen is one focus ring: the table is focused first because it is what the television did
        before this screen existed, which keeps that a single press.
    -->
    <Button
        android:id="@+id/tvOpenTable"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:text="@string/tv_home_table"
        android:textSize="20sp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:tag="accentBg"
        android:backgroundTint="?attr/colorPrimary"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/tvOpenTournament"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:text="@string/tv_home_tournament"
        android:textSize="20sp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:focusable="true" />

</LinearLayout>

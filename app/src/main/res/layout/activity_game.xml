<?xml version="1.0" encoding="utf-8"?>
<!--
    A FrameLayout only so the reaction popup can float. Everything else is the column inside it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:paddingBottom="0dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:padding="9dp" />

        <TextView
            android:id="@+id/turnStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/turnTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_dark"
            android:visibility="gone" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/turnTimerBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:visibility="gone" />

    <com.yahtzee.online.dice3d.Dice3DView
        android:id="@+id/dice3DView"
        android:layout_width="match_parent"
        android:layout_height="215dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!--
        Says what a Yahtzee on the table is actually worth. The bonus applies itself when the
        roll is scored, so without this the player sees only whatever the chosen box paid — a 0,
        often — and never learns the 100 was added.
    -->
    <TextView
        android:id="@+id/yahtzeeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:padding="10dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/yahtzee_banner_background"
        android:visibility="gone" />

    <!-- Reactions and chat. Online only: there is nobody to talk to in a solo game. -->
    <LinearLayout
        android:id="@+id/socialRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <!--
            Scrolls rather than clips. Seven emoji plus three buttons is more than a narrow phone
            has room for at a large system font, and a row that runs out of space would otherwise
            take it out of the emoji — silently cutting the last of them off the end.
        -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/reactionRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center" />

        </HorizontalScrollView>

        <!--
            Calls it on somebody else's roll. The automatic shout only fires for the player who did
            it, on a roll the rules judged worth it; this is how the rest of the table says so.
        -->
        <Button
            android:id="@+id/offTheRipButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="12sp"
            android:text="@string/off_the_rip_button"
            android:tag="accentText"
            android:textColor="?attr/colorPrimary" />

        <!-- Only shown while the room is waiting on somebody who is not you. -->
        <Button
            android:id="@+id/nudgeButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="12sp"
            android:text="@string/nudge"
            android:tag="accentText"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <Button
            android:id="@+id/chatButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="12sp"
            android:text="@string/chat_open"
            android:tag="accentText"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/holdRow"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!--
        Takes the hold row's place between turns. The dice have been put down and there is
        nothing left to keep or throw back, so the space says what the turn was worth instead of
        showing five chips that cannot be tapped.
    -->
    <TextView
        android:id="@+id/turnSummaryText"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <!--
        Scorepad rooms only: the dice you actually rolled, typed in.

        Sits where the roll button does and replaces it, because in a room with real dice on the
        table the app has nothing to roll. Five steppers rather than a keypad — the value is
        always one to six, and tapping a die up is quicker than opening a keyboard for one digit.
    -->
    <LinearLayout
        android:id="@+id/diceEntryRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/enterDiceButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/scorepad_put_down"
        android:tag="accentBg"
        android:backgroundTint="?attr/colorPrimary"
        android:visibility="gone" />

    <Button
        android:id="@+id/rollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/roll_dice"
        android:tag="accentBg"
        android:backgroundTint="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/rollsLeftText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/scorecard_card_background"
        android:clipChildren="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scorecard_label"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <!-- Where this card is heading. Off unless the player turned it on in Settings. -->
            <TextView
                android:id="@+id/projectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:paddingEnd="10dp"
                android:textColor="@color/text_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/scorecardTotalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/playerTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!--
            Two columns when the card will fit that way, one when it will not.

            A single column of seventeen rows needs about 23dp a row to fit the height left after
            the table and the controls, which is smaller than the numbers can be read at. Side by
            side the halves are eight and nine rows, which fits comfortably — but only for the
            classic single card: six cards mean six cells in every row, and six cells plus a
            label do not fit half a phone's width. The screen picks between them once it knows
            how many cards are in play.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ListView
                android:id="@+id/scorecardList"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

            <ListView
                android:id="@+id/scorecardListLower"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:scrollbars="none" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

    <!--
        Where reaction emoji fly. Full-bleed and untouchable, so a flurry can cross the whole
        screen without any of it intercepting a tap meant for the dice or the scorecard.
    -->
    <FrameLayout
        android:id="@+id/emojiBurstLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

    <!--
        What happened while this game was closed.

        Floats rather than sitting in the column, for the same reason the reaction popup does: it
        appears on arrival and goes away again, and a block of text shoving the scorecard down and
        back would move a category out from under a thumb already reaching for it. Tappable, unlike
        everything else on this layer, because it is the one thing here somebody may want gone
        before it decides to go by itself.
    -->
    <TextView
        android:id="@+id/recapPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="90dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/reaction_popup_background"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <!--
        Floats over the table rather than sitting in the column. In the column it was a row that
        appeared and vanished, shoving the hold row, the roll button and the whole scorecard down
        and back for two and a half seconds — long enough that a reaction arriving while you were
        aiming at a category could move the box out from under your thumb.

        Not clickable, so it never eats a tap meant for the dice underneath.
    -->
    <TextView
        android:id="@+id/reactionPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="150dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/reaction_popup_background"
        android:elevation="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!--
        Five of a kind, said out loud. Overlaid and inert so it never eats a tap, and centred
        because it is the one thing on this screen that is not information.
    -->
    <TextView
        android:id="@+id/yahtzeeShout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/reaction_popup_background"
        android:elevation="12dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>

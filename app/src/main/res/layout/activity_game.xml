<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/turnStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="12dp" />

    <com.yahtzee.online.dice3d.Dice3DView
        android:id="@+id/dice3DView"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/camHeightLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="12sp" />
    <SeekBar
        android:id="@+id/camHeightSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="200" />

    <TextView
        android:id="@+id/camDistLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="12sp" />
    <SeekBar
        android:id="@+id/camDistSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="250" />

    <TextView
        android:id="@+id/camFovLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_dark"
        android:textSize="12sp" />
    <SeekBar
        android:id="@+id/camFovSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="70"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/holdRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/rollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/roll_dice"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/rollsLeftText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="12dp" />

    <ListView
        android:id="@+id/scorecardList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    A FrameLayout only so the reaction popup can float. Everything else is the column inside it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:paddingBottom="0dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/back"
            android:padding="9dp" />

        <TextView
            android:id="@+id/turnStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_dark" />

        <TextView
            android:id="@+id/turnTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:textColor="@color/text_dark"
            android:visibility="gone" />

    </LinearLayout>

    <ProgressBar
        android:id="@+id/turnTimerBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:visibility="gone" />

    <com.yahtzee.online.dice3d.Dice3DView
        android:id="@+id/dice3DView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!--
        Says what a Yahtzee on the table is actually worth. The bonus applies itself when the
        roll is scored, so without this the player sees only whatever the chosen box paid — a 0,
        often — and never learns the 100 was added.
    -->
    <TextView
        android:id="@+id/yahtzeeBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:padding="10dp"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/yahtzee_banner_background"
        android:visibility="gone" />

    <!-- Reactions and chat. Online only: there is nobody to talk to in a solo game. -->
    <LinearLayout
        android:id="@+id/socialRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/reactionRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center" />

        <Button
            android:id="@+id/chatButton"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="12sp"
            android:text="@string/chat_open"
            android:tag="accentText"
            android:textColor="?attr/colorPrimary" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/holdRow"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/rollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:text="@string/roll_dice"
        android:tag="accentBg"
        android:backgroundTint="?attr/colorPrimary"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/rollsLeftText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/scorecard_card_background"
        android:clipChildren="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/scorecard_label"
                android:textAllCaps="true"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/text_muted" />

            <TextView
                android:id="@+id/scorecardTotalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/playerTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <ListView
            android:id="@+id/scorecardList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp" />

    </LinearLayout>

</LinearLayout>

    <!--
        Floats over the table rather than sitting in the column. In the column it was a row that
        appeared and vanished, shoving the hold row, the roll button and the whole scorecard down
        and back for two and a half seconds — long enough that a reaction arriving while you were
        aiming at a category could move the box out from under your thumb.

        Not clickable, so it never eats a tap meant for the dice underneath.
    -->
    <TextView
        android:id="@+id/reactionPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="150dp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/reaction_popup_background"
        android:elevation="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>

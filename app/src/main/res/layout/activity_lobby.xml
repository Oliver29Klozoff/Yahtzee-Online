<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/back"
        android:padding="10dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/roomCodeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/text_dark"
        android:text="@string/room_code_label" />

    <TextView
        android:id="@+id/roomCodeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="48sp"
        android:textStyle="bold"
        android:tag="accentText"
        android:textColor="?attr/colorPrimary"
        android:letterSpacing="0.2"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/players_label"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/playersList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/waitingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/waiting_for_players"
        android:textColor="@color/text_muted"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/inviteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/shareInviteButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/share_invite"
            android:tag="accentText"
            android:textColor="?attr/colorPrimary" />

        <Button
            android:id="@+id/inviteRecentButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/invite_recent"
            android:tag="accentText"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <Button
        android:id="@+id/startGameButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/start_game"
        android:tag="accentBg"
        android:backgroundTint="?attr/colorPrimary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/rollOffStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/playBotsInsteadButton"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/play_bots_instead"
        android:tag="accentText"
        android:textColor="?attr/colorPrimary"
        android:visibility="gone" />

    <com.yahtzee.online.dice3d.Dice3DView
        android:id="@+id/rollOffDice"
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/rollOffScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/rollOffRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <Button
        android:id="@+id/rollForFirstButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/roll_for_first"
        android:visibility="gone" />

</LinearLayout>

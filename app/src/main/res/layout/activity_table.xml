<?xml version="1.0" encoding="utf-8"?>
<!--
    The television's view of a game. Nothing here is interactive: a TV has no touch and the whole
    point is that the phones do the playing, so every control lives on the phones and this shows
    only what is happening.

    The left panel changes job when the game starts. Before it starts, the only useful thing a
    screen can offer is a way in, so the code fills it. Once people are playing, the useful thing
    is the scorecards — but the code stays, shrunk into the corner, because a latecomer can still
    take a seat and a room nobody can find is no use to them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.42"
        android:orientation="vertical">

        <!-- Before the game: the way in, as large as the panel allows. -->
        <LinearLayout
            android:id="@+id/joinPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="34sp"
                android:textStyle="bold"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_scan_to_play"
                android:textSize="15sp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <ImageView
                android:id="@+id/tableQr"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:padding="10dp"
                android:background="@android:color/white"
                android:contentDescription="@string/tv_scan_to_play" />

            <TextView
                android:id="@+id/tableRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="38sp"
                android:textStyle="bold"
                android:letterSpacing="0.25"
                android:layout_marginTop="12dp"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tableHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_muted"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- During the game: everyone's card, with the code kept small at the foot. -->
        <LinearLayout
            android:id="@+id/cardPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/scorecardGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/tableQrSmall"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:padding="5dp"
                    android:background="@android:color/white"
                    android:contentDescription="@string/tv_scan_to_join_late" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tableRoomCodeSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.18"
                        android:tag="accentText"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tv_scan_to_join_late"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.58"
        android:orientation="vertical"
        android:paddingStart="24dp">

        <TextView
            android:id="@+id/tableTurnText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="4dp" />

        <com.yahtzee.online.dice3d.Dice3DView
            android:id="@+id/tableDice"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Which dice the player is keeping, so the table can follow the decision. -->
        <LinearLayout
            android:id="@+id/tableHeldRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tableHeldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:id="@+id/tableScores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <!--
            The last few things said in the room, on the screen everyone is already facing.

            A television cannot answer, so this is a read-only window onto the chat rather than a
            copy of it — which is the useful half here anyway: somebody says something on their
            phone and the room sees it without anybody having to look down.
        -->
        <LinearLayout
            android:id="@+id/tableChat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp" />

    </LinearLayout>

</LinearLayout>

    <!--
        Where reactions fly. Full-bleed and inert, so a flurry can cross the whole screen.
    -->
    <FrameLayout
        android:id="@+id/emojiBurstLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="noHideDescendants" />

    <!--
        What somebody just scored, and the off-the-rip shout. Larger than the phone's, because it
        is being read from across a room rather than from a hand.
    -->
    <TextView
        android:id="@+id/reactionPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/reaction_popup_background"
        android:elevation="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>

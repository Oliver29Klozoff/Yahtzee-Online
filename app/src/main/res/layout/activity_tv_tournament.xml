<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal"
    android:padding="28dp">

    <!-- The bracket takes the room. It is the thing people look up at. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTourneyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTourneyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="14dp" />

        <com.yahtzee.online.ui.tournament.BracketView
            android:id="@+id/tvBracket"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!--
        The code column, which is only up while there is a seat to fill. A television cannot be
        typed into, so this is the whole of how somebody gets into the draw.
    -->
    <LinearLayout
        android:id="@+id/tvJoinColumn"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginStart="28dp">

        <ImageView
            android:id="@+id/tvTourneyQr"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:padding="8dp"
            android:background="@android:color/white"
            android:contentDescription="@string/room_code_label" />

        <TextView
            android:id="@+id/tvTourneyCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"
            android:textColor="@color/text_dark"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvTourneyHint"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/tvTourneyEntrants"
            android:layout_width="230dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="@color/text_dark"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</LinearLayout>

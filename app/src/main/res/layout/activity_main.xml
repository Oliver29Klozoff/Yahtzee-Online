<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="32sp"
                android:textStyle="bold"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:textSize="15sp"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginBottom="26dp" />

            <LinearLayout
                android:id="@+id/dailyCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/daily_card_background"
                android:foreground="?attr/selectableItemBackground"
                android:padding="18dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_challenge"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:id="@+id/dailyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:paddingTop="3dp" />
            </LinearLayout>

            <!--
                Sits directly under the daily card because it is the same idea aimed at one
                person: fixed dice, one attempt, judgement only.
            -->
            <LinearLayout
                android:id="@+id/duelCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/daily_card_background"
                android:foreground="?attr/selectableItemBackground"
                android:padding="18dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark" />

                <TextView
                    android:id="@+id/duelStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/duel_subtitle"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:paddingTop="3dp" />

                <LinearLayout
                    android:id="@+id/duelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="10dp" />
            </LinearLayout>

            <!--
                Standing records against people you actually play. Hidden until there is one,
                since an empty "rivals" heading on a fresh install explains nothing.
            -->
            <LinearLayout
                android:id="@+id/rivalsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rivals"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rivals_hint"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rivalsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activeGamesSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="18dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/your_games"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text_muted" />

                    <!-- Long press is invisible without saying so, and a game nobody can get rid
                         of is worse than a list that explains itself. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hold_to_remove"
                        android:textSize="11sp"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/activeGamesList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <Button
                android:id="@+id/continueGameButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/continue_game"
                android:tag="accentBg"
                android:backgroundTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/createRoomButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/create_room"
                android:tag="accentBg"
                android:backgroundTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <EditText
                android:id="@+id/roomCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/room_code"
                android:inputType="textCapCharacters"
                android:maxLines="1"
                android:textColor="@color/text_dark"
                android:tag="accentBg"
                android:backgroundTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/scanCodeButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/scan_code"
                android:tag="accentText"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/joinRoomButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/join_room"
                android:tag="accentBg"
                android:backgroundTint="?attr/colorPrimary"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/row_border"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/leaderboardHeading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/leaderboard"
                    android:textAllCaps="true"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_muted" />

                <!-- One button that swaps which board is shown, rather than a tab strip: there
                     are only two, and the label always names the one you would switch to. -->
                <Button
                    android:id="@+id/leaderboardToggle"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/daily_board"
                    android:textSize="12sp"
                    android:tag="accentText"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leaderboardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/leaderboardEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/leaderboard_empty"
                android:textSize="14sp"
                android:textColor="@color/text_muted"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/statsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_stats"
            android:contentDescription="@string/stats"
            android:padding="12dp" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings"
            android:padding="10dp" />
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Somewhere for EmojiPop to hang the animation currently running on a popup.

        A view tag needs a key that cannot collide with anyone else's, and the framework insists
        that key be an id resource rather than an arbitrary integer.
    -->
    <item name="emojiPopTag" type="id" />

    <!--
        Where AccentColor stashes a button's own background before painting a gradient over it.

        Without it the gradient would be a one-way door: the original drawable carries the
        button's shape, its press feedback and its disabled state, and once overwritten there is
        nothing to put back when the setting is switched off again.
    -->
    <item name="accent_original_bg" type="id" />
</resources>

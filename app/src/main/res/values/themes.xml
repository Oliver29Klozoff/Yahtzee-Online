<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.YahtzeeOnline" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColor">@color/text_dark</item>
    </style>

    <!--
        One theme per accent. Only the three brand colours differ; everything else is inherited,
        so a change to the base theme reaches all of them. These exist as styles because a theme
        is what reaches the parts of a Button the platform draws itself.
    -->
    <style name="Theme.YahtzeeOnline.Emerald">
        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="colorPrimaryDark">@color/accent_emerald_dark</item>
        <item name="colorAccent">@color/accent_emerald</item>
    </style>

    <style name="Theme.YahtzeeOnline.Amber">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryDark">@color/accent_amber_dark</item>
        <item name="colorAccent">@color/accent_amber</item>
    </style>

    <style name="Theme.YahtzeeOnline.Crimson">
        <item name="colorPrimary">@color/accent_crimson</item>
        <item name="colorPrimaryDark">@color/accent_crimson_dark</item>
        <item name="colorAccent">@color/accent_crimson</item>
    </style>

    <style name="Theme.YahtzeeOnline.Amethyst">
        <item name="colorPrimary">@color/accent_amethyst</item>
        <item name="colorPrimaryDark">@color/accent_amethyst_dark</item>
        <item name="colorAccent">@color/accent_amethyst</item>
    </style>

    <style name="Theme.YahtzeeOnline.Cyan">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryDark">@color/accent_cyan_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
    </style>

    <style name="Theme.YahtzeeOnline.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/background</item>
        <item name="postSplashScreenTheme">@style/Theme.YahtzeeOnline</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Declared not-required so a television is not ruled out for lacking hardware a dice game
        does not need. Without these a TV treats the app as incompatible, and its launcher will
        not list it even once it is installed.
    -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Refusable from Android 13, so nothing depends on it being granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".YahtzeeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YahtzeeOnline">

        <activity
            android:name=".ui.SplashActivity"
            android:theme="@style/Theme.YahtzeeOnline.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Invite links. The app's own scheme rather than https: making an https link open
                the app directly requires a website serving an assetlinks file to vouch for it,
                and this app has no site. Shared messages carry the room code in plain text too,
                for wherever a custom scheme is not made tappable.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yahtzee" android:host="join" />
                <!-- Duel challenges arrive the same way, with their own host. -->
                <data android:scheme="yahtzee" android:host="duel" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.duel.DuelActivity" android:exported="false" />

        <activity android:name=".ui.NameActivity" android:exported="false" />
        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.lobby.LobbyActivity" android:exported="false" />
        <!--
            Orientation is deliberately NOT handled here.

            Declaring it meant the screen was never re-inflated when the phone turned, so the
            portrait column was simply stretched across a landscape window — dice spanning the
            whole width, the hold row cut off, and no scorecard at all — and the landscape layout
            could never be reached. Letting these restart is what lets each orientation have the
            layout built for it. Neither loses anything by restarting: the online game reads its
            state from the room, and the solo game is written to disk after every move.
        -->
        <activity
            android:name=".ui.game.GameActivity"
            android:exported="false"
            android:configChanges="keyboardHidden" />
        <activity
            android:name=".ui.bot.SoloGameActivity"
            android:exported="false"
            android:configChanges="keyboardHidden" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.StatsActivity" android:exported="false" />

        <!--
            The television entry point. A TV launcher lists only what carries LEANBACK_LAUNCHER,
            and pointing it here rather than at the splash is what makes a TV open the table
            directly instead of the phone game it cannot drive.
        -->
        <activity
            android:name=".ui.tv.TableActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.ReviewActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>

{
  "rules": {
    "leaderboard": {
      ".read": "auth != null",
      ".indexOn": ["bestScore"],
      "$profileId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'bestScore'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "bestScore": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "boards": {
      "$boardId": {
        ".read": "auth != null",
        ".indexOn": ["bestScore"],
        "$profileId": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['name', 'bestScore'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "bestScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "dailyBoard": {
      "$dayId": {
        ".read": "auth != null",
        ".indexOn": ["bestScore"],
        "$profileId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['name', 'bestScore'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "bestScore": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "invites": {
      "$profileId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$roomCode": {
          ".validate": "newData.hasChildren(['fromName', 'fromId'])",
          "fromName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "fromId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },

    "duels": {
      ".read": "auth != null",
      ".indexOn": ["createdAt"],
      "$duelCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['createdAt'])",
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "players": {
          "$profileId": {
            ".validate": "newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000 && !data.exists()"
            },
            "finishedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "tournaments": {
      ".read": "auth != null",
      ".indexOn": ["updatedAt"],
      "$tourneyCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['code', 'hostId', 'status'])",

        "code": {
          ".validate": "newData.val() === $tourneyCode"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "hostId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'OPEN' || newData.val() === 'RUNNING' || newData.val() === 'DONE')"
        },
        "cardCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id": {
              ".validate": "newData.val() === $playerId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "seed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "matches": {
          "$matchId": {
            ".validate": "newData.hasChildren(['round', 'slot'])",
            "round": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8"
            },
            "slot": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 64"
            },
            "aId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "bId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "aScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
            },
            "bScore": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6000"
            },
            "winnerId": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "roomCode": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "status": {
              ".validate": "newData.isString() && (newData.val() === 'PENDING' || newData.val() === 'PLAYING' || newData.val() === 'DONE')"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },

    "games": {
      ".read": "auth != null",
      ".indexOn": ["updatedAt"],
      "$roomCode": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['roomCode', 'hostId', 'status'])",

        "roomCode": {
          ".validate": "newData.val() === $roomCode"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'LOBBY' || newData.val() === 'ROLL_OFF' || newData.val() === 'PLAYING' || newData.val() === 'FINISHED')"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "openingRolls": {
          "$playerId": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
          }
        },
        "openingRollTied": {
          "$index": {
            ".validate": "newData.isString()"
          }
        },
        "turnDeadline": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "cardCount": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
        },
        "turnSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
        },
        "dice": {
          "$index": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
          }
        },
        "held": {
          "$index": {
            ".validate": "newData.isBoolean()"
          }
        },
        "currentTurnIndex": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "rollsUsed": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "nudge": {
          ".validate": "newData.hasChildren(['toPlayerId', 'at'])",
          "byName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          },
          "toPlayerId": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "chat": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'text'])",
            "senderId": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
            },
            "senderName": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "reactions": {
          "$playerId": {
            ".validate": "newData.hasChildren(['emoji'])",
            "emoji": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 8"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id": {
              ".validate": "newData.val() === $playerId"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
            },
            "scores": {
              "$category": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              }
            },
            "yahtzeeBonusCount": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "diceColor": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      }
    }
  }
}
